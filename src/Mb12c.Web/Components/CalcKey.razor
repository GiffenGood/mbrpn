@* One key: gold f-legend on the faceplate above, key block with white top legend and
   blue g-legend on the front bevel. *@
<div class="key-cell @ExtraClass" style="@CellStyle">
    <div class="f-label">@(Def.FLabel ?? " ")</div>
    <button type="button" class="key @KeyClass" @onclick="() => OnPress.InvokeAsync(Def.Id)">
        @if (Def.Id == KeyId.Enter)
        {
            <span class="key-top enter-top">E<br />N<br />T<br />E<br />R</span>
        }
        else
        {
            <span class="key-top">@Def.PrimaryLabel</span>
        }
        <span class="key-front">@(Def.GLabel ?? " ")</span>
    </button>
</div>

@code {
    [Parameter, EditorRequired] public KeyDef Def { get; set; } = default!;
    [Parameter] public EventCallback<KeyId> OnPress { get; set; }

    private string ExtraClass => Def.Id == KeyId.Enter ? "cell-enter" : "";

    private string CellStyle => Def.Id == KeyId.Enter
        ? $"grid-column:{Def.Col};grid-row:3 / span 2;"
        : $"grid-column:{Def.Col};grid-row:{Def.Row};";

    private string KeyClass => Def.Id switch
    {
        KeyId.F => "key-f",
        KeyId.G => "key-g",
        KeyId.Enter => "key-enter",
        _ => "",
    };
}
