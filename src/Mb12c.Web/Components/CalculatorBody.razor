@* The full faceplate: silver display band with the MB-12c badge, then the 4×10 key grid
   rendered straight from KeyboardMap (ENTER spans rows 3–4). *@
<div class="calc-body">
    <div class="calc-face">
        <div class="display-band">
            <div class="brand-badge">
                <span class="brand-logo">MB</span>
                <span class="brand-model">12c</span>
            </div>
            <LcdDisplay State="DisplayState" />
            <div class="band-right">
                <span class="band-script">mb-12c</span>
            </div>
        </div>

        <div class="key-grid">
            @foreach (var def in OrderedKeys)
            {
                <CalcKey Def="def" OnPress="OnPress" />
            }
            <div class="clear-bracket"><span>CLEAR</span></div>
        </div>

        <div class="face-footer">
            <span class="footer-line"></span>
            <span class="footer-text">M &nbsp;B&nbsp;E&nbsp;C&nbsp;K&nbsp;I&nbsp;U&nbsp;S</span>
            <span class="footer-line"></span>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public DisplayState DisplayState { get; set; } = default!;
    [Parameter] public EventCallback<KeyId> OnPress { get; set; }

    private static readonly IReadOnlyList<KeyDef> OrderedKeys =
        KeyboardMap.Keys.OrderBy(k => k.Row).ThenBy(k => k.Col).ToList();
}
