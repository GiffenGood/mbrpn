@page "/"
@using Mb12c.Engine.State
@using Mb12c.Web.Services
@inject IJSRuntime Js
@implements IDisposable

<PageTitle>MB-12c Financial Calculator</PageTitle>

<div class="page">
    <CalculatorBody DisplayState="_engine.Display" OnPress="PressAsync" />
    <p class="hint">
        Keyboard: digits, <kbd>.</kbd> <kbd>Enter</kbd> <kbd>+</kbd> <kbd>−</kbd> <kbd>×</kbd> <kbd>÷</kbd>,
        <kbd>f</kbd> <kbd>g</kbd> <kbd>s</kbd>=STO <kbd>r</kbd>=RCL <kbd>n</kbd> <kbd>i</kbd>
        <kbd>p</kbd>=PV <kbd>m</kbd>=PMT <kbd>v</kbd>=FV <kbd>c</kbd>=CHS <kbd>e</kbd>=EEX
        <kbd>y</kbd>=yˣ <kbd>x</kbd>=x≷y <kbd>d</kbd>=R↓ <kbd>Space</kbd>=R/S
        <kbd>Backspace</kbd>=CLx <kbd>Esc</kbd>=ON
    </p>
</div>

@code {
    private readonly CalculatorEngine _engine = new();
    private PersistenceService _persistence = default!;
    private DotNetObjectReference<Calculator>? _selfRef;
    private System.Timers.Timer? _saveTimer;
    private bool _dirty;

    protected override async Task OnInitializedAsync()
    {
        _persistence = new PersistenceService(Js);
        try
        {
            string? json = await _persistence.LoadAsync();
            if (json is not null && StateSerializer.FromJson(json) is { } state)
                _engine.Restore(state);
        }
        catch
        {
            // corrupted or unavailable storage: start fresh
        }
        _engine.Changed += OnEngineChanged;

        _saveTimer = new System.Timers.Timer(500) { AutoReset = true };
        _saveTimer.Elapsed += async (_, _) => await FlushSaveAsync();
        _saveTimer.Start();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _selfRef = DotNetObjectReference.Create(this);
            await Js.InvokeVoidAsync("mb12c.init", _selfRef);
        }
    }

    private void OnEngineChanged() => _dirty = true;

    private async Task FlushSaveAsync()
    {
        if (!_dirty) return;
        _dirty = false;
        try
        {
            await _persistence.SaveAsync(StateSerializer.ToJson(_engine.Snapshot()));
        }
        catch
        {
            // storage unavailable: continuous memory is best-effort
        }
    }

    [JSInvokable]
    public async Task OnBrowserKey(string key)
    {
        if (KeyboardMapper.Map(key) is { } keyId)
            await PressAsync(keyId);
        StateHasChanged();
    }

    private async Task PressAsync(KeyId key)
    {
        bool wasRunning = _engine.IsRunning;
        _engine.Press(key);
        if (!wasRunning && _engine.IsRunning)
            await RunLoopAsync();
    }

    /// <summary>Drives program execution without blocking the UI, honoring PSE pauses.</summary>
    private async Task RunLoopAsync()
    {
        int steps = 0;
        while (_engine.IsRunning)
        {
            var status = _engine.StepProgram();
            if (status == ProgramStepResult.Paused)
            {
                StateHasChanged();
                await Task.Delay(1100);
                continue;
            }
            if (status is ProgramStepResult.Halted or ProgramStepResult.Errored) break;
            if (++steps % 500 == 0)
            {
                StateHasChanged();
                await Task.Yield(); // keep the browser responsive during long programs
            }
        }
        StateHasChanged();
    }

    public void Dispose()
    {
        _engine.Changed -= OnEngineChanged;
        _saveTimer?.Dispose();
        _selfRef?.Dispose();
    }
}
