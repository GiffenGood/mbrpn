@* One LCD digit cell: seven segments plus decimal point and comma tail, drawn as SVG. *@
<svg class="seg-digit" viewBox="0 0 58 92" aria-hidden="true">
    <g class="segs">
        <polygon class="@Cls('a')" points="10,4 48,4 42,12 16,12" />
        <polygon class="@Cls('b')" points="50,6 50,42 43,38 43,14" />
        <polygon class="@Cls('c')" points="50,50 50,86 43,78 43,54" />
        <polygon class="@Cls('d')" points="10,88 48,88 42,80 16,80" />
        <polygon class="@Cls('e')" points="8,50 8,86 15,78 15,54" />
        <polygon class="@Cls('f')" points="8,6 8,42 15,38 15,14" />
        <polygon class="@Cls('g')" points="12,46 18,42 40,42 46,46 40,50 18,50" />
    </g>
    <circle class="@(Cell.Point ? "seg on" : "seg")" cx="55" cy="86" r="3.4" />
    <path class="@(Cell.Comma ? "seg on" : "seg")" d="M52,90 L58,90 L54,100 L50,100 Z" />
</svg>

@code {
    [Parameter] public DigitCell Cell { get; set; }

    private static readonly Dictionary<char, string> Map = new()
    {
        ['0'] = "abcdef", ['1'] = "bc", ['2'] = "abged", ['3'] = "abgcd", ['4'] = "fgbc",
        ['5'] = "afgcd", ['6'] = "afgedc", ['7'] = "abc", ['8'] = "abcdefg", ['9'] = "abcdfg",
        ['-'] = "g", ['E'] = "afged", ['r'] = "eg", ['o'] = "cdeg", ['n'] = "ceg",
        ['u'] = "cde", ['i'] = "c", ['g'] = "abcdfg", ['P'] = "abefg", ['A'] = "abcefg",
        ['C'] = "adef", ['d'] = "bcdeg", ['L'] = "def", ['S'] = "afgcd", ['t'] = "defg",
        [' '] = "",
    };

    private string Cls(char segment)
    {
        string lit = Map.TryGetValue(Cell.Char, out var segs) ? segs : "";
        return lit.Contains(segment) ? "seg on" : "seg";
    }
}
