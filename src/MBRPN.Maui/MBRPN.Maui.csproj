<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>MBRPN.Maui</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>

    <ApplicationTitle>MB-RPN</ApplicationTitle>
    <ApplicationId>com.mbeckius.mbrpn</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

    <!-- Unpackaged so `dotnet build -t:Run` launches without MSIX signing. -->
    <WindowsPackageType>None</WindowsPackageType>

    <!-- Pick up the JDK that `-t:InstallAndroidDependencies` bootstraps, so a plain
         `dotnet build` works without passing JavaSdkDirectory every time. -->
    <JavaSdkDirectory Condition="'$(JavaSdkDirectory)' == '' And Exists('$(LocalAppData)\Android\Jdk\bin\java.exe')">$(LocalAppData)\Android\Jdk</JavaSdkDirectory>
  </PropertyGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.png" Color="#0c0f13" />
    <MauiSplashScreen Include="Resources\Splash\splash.png" Color="#0c0f13" BaseSize="128,128" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MBRPN.Engine\MBRPN.Engine.csproj" />
  </ItemGroup>

</Project>
